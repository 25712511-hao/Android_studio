<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background">#101512</color>
    <color name="surface">#1C241F</color>
    <color name="outline">#3B5044</color>
    <color name="image_background">#0D110F</color>
    <color name="text_primary">#F1F5EF</color>
    <color name="text_secondary">#B9C8BE</color>
    <color name="accent">#C7F898</color>
    <color name="on_accent">#19270E</color>

    <style name="Theme.AnhLat" parent="Theme.AppCompat.NoActionBar">
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.AnhLat.Preview" parent="Theme.AppCompat.Dialog">
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.82</item>
    </style>
</resources>
