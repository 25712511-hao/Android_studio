<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/tvToolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="UAMP"
        app:titleTextColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivAlbum"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:src="@drawable/image3"
        android:background="@drawable/album_border"
        android:padding="2dp"
        android:scaleType="centerCrop"
        android:contentDescription="Ảnh bìa album"
        app:layout_constraintTop_toBottomOf="@id/tvToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/viewBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#CCFFFFFF"
        app:layout_constraintBottom_toBottomOf="@id/ivAlbum"
        app:layout_constraintStart_toStartOf="@id/ivAlbum"
        app:layout_constraintEnd_toEndOf="@id/ivAlbum" />

    <ImageButton
        android:id="@+id/btnPlay"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_media_pause"
        android:contentDescription="Phát hoặc tạm dừng"
        app:layout_constraintTop_toTopOf="@id/viewBar"
        app:layout_constraintBottom_toBottomOf="@id/viewBar"
        app:layout_constraintStart_toStartOf="@id/viewBar" />

    <TextView
        android:id="@+id/tvSongTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        android:text="Drop and Roll"
        android:textColor="#424242"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/viewBar"
        app:layout_constraintStart_toEndOf="@id/btnPlay"
        app:layout_constraintEnd_toStartOf="@id/tvCurrentTime" />

    <TextView
        android:id="@+id/tvArtist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Silent Partner"
        android:textColor="#757575"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvSongTitle"
        app:layout_constraintStart_toStartOf="@id/tvSongTitle"
        app:layout_constraintEnd_toEndOf="@id/tvSongTitle" />

    <TextView
        android:id="@+id/tvCurrentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:text="1:01"
        android:textColor="#424242"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="@id/viewBar"
        app:layout_constraintEnd_toEndOf="@id/viewBar" />

    <TextView
        android:id="@+id/tvTotalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2:01"
        android:textColor="#757575"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvCurrentTime"
        app:layout_constraintEnd_toEndOf="@id/tvCurrentTime" />

</androidx.constraintlayout.widget.ConstraintLayout>