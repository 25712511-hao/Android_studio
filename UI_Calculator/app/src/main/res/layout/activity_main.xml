<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/card_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Timeout: label + percent + progress bar (10 seconds) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Thời gian nhập số"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbTimeout"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/progress_timeout" />

        <!-- Display: expression + result, takes the spare height -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom|end"
            android:minHeight="140dp"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/txtExpression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/txtResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="44sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="44sp"
                app:autoSizeMinTextSize="20sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <!-- Keypad: 4 equal columns (chain on row 1, other rows align to it), every key is a square -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/keypad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <Button
                android:id="@+id/btnE"
                android:layout_width="0dp"
                android:layout_height="38dp"
                app:layout_constraintStart_toStartOf="@id/btnClear"
                app:layout_constraintEnd_toEndOf="@id/btnClear"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="8dp"
                android:background="@drawable/key_pill"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="e"
                android:textAllCaps="false"
                android:textColor="@color/text_fn"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/btnMu"
                android:layout_width="0dp"
                android:layout_height="38dp"
                app:layout_constraintStart_toStartOf="@id/btnDelete"
                app:layout_constraintEnd_toEndOf="@id/btnDelete"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="8dp"
                android:background="@drawable/key_pill"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="μ"
                android:textAllCaps="false"
                android:textColor="@color/text_fn"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/btnSin"
                android:layout_width="0dp"
                android:layout_height="38dp"
                app:layout_constraintStart_toStartOf="@id/btnDiv"
                app:layout_constraintEnd_toEndOf="@id/btnDiv"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="8dp"
                android:background="@drawable/key_pill"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="sin"
                android:textAllCaps="false"
                android:textColor="@color/text_fn"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/btnDeg"
                android:layout_width="0dp"
                android:layout_height="38dp"
                app:layout_constraintStart_toStartOf="@id/btnMul"
                app:layout_constraintEnd_toEndOf="@id/btnMul"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="8dp"
                android:background="@drawable/key_pill"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="deg"
                android:textAllCaps="false"
                android:textColor="@color/text_fn"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,1:1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintEnd_toStartOf="@id/btnDelete"
                app:layout_constraintTop_toBottomOf="@id/btnE"
                android:layout_marginTop="16dp"
                android:background="@drawable/key_digit"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="Ac"
                android:textAllCaps="false"
                android:textColor="@color/text_gray_key"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,1:1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintStart_toEndOf="@id/btnClear"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintEnd_toStartOf="@id/btnDiv"
                app:layout_constraintTop_toBottomOf="@id/btnE"
                android:layout_marginTop="16dp"
                android:background="@drawable/key_digit"
                android:padding="0dp"
                android:src="@drawable/ic_backspace"/>
            <Button
                android:id="@+id/btnDiv"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,1:1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintStart_toEndOf="@id/btnDelete"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintEnd_toStartOf="@id/btnMul"
                app:layout_constraintTop_toBottomOf="@id/btnE"
                android:layout_marginTop="16dp"
                android:background="@drawable/key_op"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="/"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/btnMul"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,1:1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintStart_toEndOf="@id/btnDiv"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnE"
                android:layout_marginTop="16dp"
                android:background="@drawable/key_op"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="*"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintStart_toStartOf="@id/btnClear"
                app:layout_constraintEnd_toEndOf="@id/btnClear"
                app:layout_constraintTop_toBottomOf="@id/btnClear"
                android:layout_marginTop="16dp"
                android:background="@drawable/key_digit"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="7"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/btn8"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintStart_toStartOf="@id/btnDelete"
                app:layout_constraintEnd_toEndOf="@id/btnDelete"
                app:layout_constraintTop_toBottomOf="@id/btnClear"
                android:layout_marginTop="16dp"
                android:background="@drawable/key_digit"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="8"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/btn9"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintStart_toStartOf="@id/btnDiv"
                app:layout_constraintEnd_toEndOf="@id/btnDiv"
                app:layout_constraintTop_toBottomOf="@id/btnClear"
                android:layout_marginTop="16dp"
                android:background="@drawable/key_digit"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="9"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/btnMinus"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintStart_toStartOf="@id/btnMul"
                app:layout_constraintEnd_toEndOf="@id/btnMul"
                app:layout_constraintTop_toBottomOf="@id/btnClear"
                android:layout_marginTop="16dp"
                android:background="@drawable/key_op"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="−"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintStart_toStartOf="@id/btnClear"
                app:layout_constraintEnd_toEndOf="@id/btnClear"
                app:layout_constraintTop_toBottomOf="@id/btn7"
                android:layout_marginTop="16dp"
                android:background="@drawable/key_digit"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="4"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintStart_toStartOf="@id/btnDelete"
                app:layout_constraintEnd_toEndOf="@id/btnDelete"
                app:layout_constraintTop_toBottomOf="@id/btn7"
                android:layout_marginTop="16dp"
                android:background="@drawable/key_digit"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="5"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/btn6"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintStart_toStartOf="@id/btnDiv"
                app:layout_constraintEnd_toEndOf="@id/btnDiv"
                app:layout_constraintTop_toBottomOf="@id/btn7"
                android:layout_marginTop="16dp"
                android:background="@drawable/key_digit"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="6"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/btnPlus"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="@id/btnMul"
                app:layout_constraintEnd_toEndOf="@id/btnMul"
                app:layout_constraintTop_toBottomOf="@id/btnMinus"
                android:background="@drawable/key_op"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:layout_constraintBottom_toTopOf="@id/btnEqual"
                app:layout_constraintVertical_weight="1"
                app:layout_constraintVertical_chainStyle="spread" />
            <Button
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintStart_toStartOf="@id/btnClear"
                app:layout_constraintEnd_toEndOf="@id/btnClear"
                app:layout_constraintTop_toBottomOf="@id/btn4"
                android:layout_marginTop="16dp"
                android:background="@drawable/key_digit"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="1"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintStart_toStartOf="@id/btnDelete"
                app:layout_constraintEnd_toEndOf="@id/btnDelete"
                app:layout_constraintTop_toBottomOf="@id/btn4"
                android:layout_marginTop="16dp"
                android:background="@drawable/key_digit"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="2"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintStart_toStartOf="@id/btnDiv"
                app:layout_constraintEnd_toEndOf="@id/btnDiv"
                app:layout_constraintTop_toBottomOf="@id/btn4"
                android:layout_marginTop="16dp"
                android:background="@drawable/key_digit"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="3"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/btn0"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="@id/btnClear"
                app:layout_constraintEnd_toEndOf="@id/btnDelete"
                app:layout_constraintTop_toTopOf="@id/btnDot"
                android:background="@drawable/key_digit"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="0"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:layout_constraintBottom_toBottomOf="@id/btnDot" />
            <Button
                android:id="@+id/btnDot"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintStart_toStartOf="@id/btnDiv"
                app:layout_constraintEnd_toEndOf="@id/btnDiv"
                app:layout_constraintTop_toBottomOf="@id/btn1"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/key_digit"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="."
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/btnEqual"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="@id/btnMul"
                app:layout_constraintEnd_toEndOf="@id/btnMul"
                app:layout_constraintTop_toBottomOf="@id/btnPlus"
                app:layout_constraintBottom_toBottomOf="@id/btnDot"
                app:layout_constraintVertical_weight="1"
                android:layout_marginTop="16dp"
                android:background="@drawable/key_equals"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="="
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                android:stateListAnimator="@null" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>